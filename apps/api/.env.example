NODE_ENV=development
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://devops:devops_local_password@localhost:5432/devops_command_center?schema=public

# --- GitHub Integration (Phase 3) ---
# Personal Access Token with: repo (or public_repo), security_events, read:user
GITHUB_TOKEN=ghp_replace_with_your_token
# The GitHub repo to track (defaults shown — change to your target repo)
GITHUB_REPO_OWNER=ruthwin09
GITHUB_REPO_NAME=DevOps-Dashboard
# Set to "true" to skip GitHub API calls and return mock data instead
GITHUB_MOCK_MODE=true

